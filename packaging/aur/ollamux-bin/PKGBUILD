# Maintainer: Jonathan Stechmann <69059260+j-stechmann@users.noreply.github.com>
pkgname=ollamux-bin
pkgver=0.5.0
pkgrel=1
pkgdesc='Key-rotating reverse proxy for the Ollama Cloud API (prebuilt binary)'
url='https://github.com/j-stechmann/ollamux'
arch=(x86_64)
license=(GPL-2.0-or-later)
depends=(glibc)
provides=(ollamux="$pkgver")
conflicts=(ollamux)
source=("$pkgname-$pkgver.tar.gz::$url/releases/download/v$pkgver/ollamux-$pkgver-x86_64.tar.gz"
        "ollamux.service::https://raw.githubusercontent.com/j-stechmann/ollamux/v$pkgver/packaging/ollamux.service"
        "ollamux.1::https://raw.githubusercontent.com/j-stechmann/ollamux/v$pkgver/packaging/ollamux.1")
sha256sums=('3f92cc297f4ab37d1fa1831d00b571be87949c2734860c9fd2ad178d5342ec47'
            'a88b8011353909db0dfd5947689d840fad5e397a4cbdf4b805257b66a49dadc8'
            '883b89299661921a301fc543d5b454ad807fb98c520ca8767305af0eb1675700')
options=(!strip)

package() {
  cd "$srcdir"
  install -Dm755 "ollamux-$pkgver-x86_64/ollamux" "$pkgdir/usr/bin/ollamux"
  install -Dm644 ollamux.1 "$pkgdir/usr/share/man/man1/ollamux.1"
  install -Dm644 ollamux.service "$pkgdir/usr/lib/systemd/system/ollamux.service"
}

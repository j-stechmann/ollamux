# Maintainer: Jonathan Stechmann <69059260+j-stechmann@users.noreply.github.com>
pkgname=ollamux
pkgver=0.5.0
pkgrel=1
pkgdesc='Key-rotating reverse proxy for the Ollama Cloud API'
url='https://github.com/j-stechmann/ollamux'
arch=(x86_64 aarch64)
license=(GPL-2.0-or-later)
depends=(glibc gcc-libs)
makedepends=(cargo)
checkdepends=(cargo)
provides=(ollamux="$pkgver")
conflicts=(ollamux-bin)
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz"
        "ollamux.service::$url/raw/v$pkgver/packaging/ollamux.service"
        "ollamux.1::$url/raw/v$pkgver/packaging/ollamux.1")
sha256sums=('2e390455dd9c5aa02b4d60e66e66682e1758ce8092da3787ec18d0187ce3232c'
            'a88b8011353909db0dfd5947689d840fad5e397a4cbdf4b805257b66a49dadc8'
            '883b89299661921a301fc543d5b454ad807fb98c520ca8767305af0eb1675700')
options=(!lto)

prepare() {
  cd "$pkgname-$pkgver"
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo build --frozen --release --locked
}

check() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo test --frozen --locked
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 "target/release/$pkgname" -t "$pkgdir/usr/bin/"
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
  install -Dm644 README.md -t "$pkgdir/usr/share/doc/$pkgname/"
  install -Dm644 "$srcdir/ollamux.1" "$pkgdir/usr/share/man/man1/ollamux.1"
  install -Dm644 "$srcdir/ollamux.service" "$pkgdir/usr/lib/systemd/system/ollamux.service"
}
